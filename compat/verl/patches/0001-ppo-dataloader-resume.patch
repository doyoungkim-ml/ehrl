+# Only torchdata's loader envelope is inspected, not custom state_dict payloads.
+_SAMPLER_FIELDS = [
+    "_index_sampler_state",
+    "_sampler_iter_state",
+    "_sampler_iter_yielded",
+    "_IterableDataset_len_called",
+    "_shared_seed",
+]
+_SINGLE_FIELDS = _SAMPLER_FIELDS + ["_num_yielded", "dataset_state", "fetcher_state", "_iterator_finished"]
+_MULTI_PATHS = [
+    ("_iterator_finished",),
+    ("_steps_since_snapshot",),
+    ("_snapshot",),
+    *(
+        ("_snapshot", key)
+        for key in ["_snapshot_step", "_last_yielded_worker_id", "_main_snapshot", "_worker_snapshots"]
+    ),
+    *(("_snapshot", "_main_snapshot", key) for key in _SAMPLER_FIELDS + ["_num_workers", "_base_seed"]),
+    ("_snapshot", "_worker_snapshots", "worker_0"),
+    *(("_snapshot", "_worker_snapshots", "worker_0", key) for key in ["worker_id", "dataset_state", "fetcher_state"]),
+]
+_MISSING = object()
+_SCHEMA_CASES = [
+    *[(0, (key,), _MISSING) for key in _SINGLE_FIELDS],
+    *[(2, keys, _MISSING) for keys in _MULTI_PATHS],
+    *[(workers, ("_iterator_finished",), value) for workers in [0, 2] for value in [None, 0, 1, "False", [], {}]],
+    *[
+        (workers, keys, value)
+        for workers, keys in [
+            (0, ("_num_yielded",)),
+            (0, ("_sampler_iter_yielded",)),
+            (2, ("_steps_since_snapshot",)),
+            (2, ("_snapshot", "_snapshot_step")),
+            (2, ("_snapshot", "_main_snapshot", "_sampler_iter_yielded")),
+        ]
+        for value in [None, -1, True, 1.5, "1"]
+    ],
+    *[
+        (2, keys, value)
+        for keys in [
+            ("_snapshot",),
+            ("_snapshot", "_main_snapshot"),
+            ("_snapshot", "_worker_snapshots"),
+            ("_snapshot", "_worker_snapshots", "worker_0"),
+        ]
+        for value in [None, [], {}]
+    ],
+    (2, ("_snapshot", "_main_snapshot", "_num_workers"), 1),
+    (2, ("_snapshot", "_main_snapshot", "_num_workers"), True),
+    (2, ("_snapshot", "_worker_snapshots", "worker_0", "worker_id"), 1),
+    (2, ("_snapshot", "_worker_snapshots", "worker_0", "worker_id"), False),
+    (2, ("_snapshot", "_last_yielded_worker_id"), 2),
+    (2, ("_snapshot", "_last_yielded_worker_id"), False),
+]
+
