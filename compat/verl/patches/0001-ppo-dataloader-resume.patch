+"""Exercise real checkpoint loading and epoch control without Ray/GPU imports.
+
+AST extraction keeps the production _load_checkpoint method unchanged. Only the
+model-compute body of fit's nested dataloader loop is replaced by a batch recorder;
+its epoch expression, bounds, and actual StatefulDataLoader iteration are retained.
+"""
+
+import ast
+import copy
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torchdata.stateful_dataloader import StatefulDataLoader
+from torchdata.stateful_dataloader.sampler import RandomSampler
+
+ROOT = Path(__file__).resolve().parents[3]
+MAIN_TRAINER = ROOT / "verl/trainer/ppo/ray_trainer.py"
+SEPARATE_TRAINER = ROOT / "verl/experimental/separation/ray_trainer.py"
+
+
+def _load_cpu_trainer(path=MAIN_TRAINER):
+    source = ast.parse(MAIN_TRAINER.read_text())
+    trainer = next(node for node in source.body if isinstance(node, ast.ClassDef) and node.name == "RayPPOTrainer")
+    methods = [
+        copy.deepcopy(node)
+        for node in trainer.body
+        if isinstance(node, ast.FunctionDef) and node.name in {"_load_checkpoint", "_get_start_epoch"}
+    ]
+    fit_source = ast.parse(path.read_text())
+    cls = next(
+        node for node in fit_source.body if isinstance(node, ast.ClassDef) and node.name.endswith("RayPPOTrainer")
+    )
+    fit = next(node for node in cls.body if isinstance(node, ast.FunctionDef) and node.name == "fit")
+    epoch_assignment = next(
+        node
+        for node in fit.body
+        if isinstance(node, ast.Assign)
+        and any(isinstance(t, ast.Name) and t.id == "current_epoch" for t in node.targets)
+    )
+    epoch_loop = copy.deepcopy(
+        next(node for node in fit.body if isinstance(node, ast.For) and node.target.id == "epoch")
+    )
+    batch_loop = next(node for node in epoch_loop.body if isinstance(node, ast.For))
+    batch_loop.body = ast.parse("observed.append((epoch, batch_dict.tolist()))").body
+    epoch_loop.body = [batch_loop]
+    fit_stub = ast.parse("def collect(self):\n    pass\n").body[0]
+    fit_stub.body = [
+        ast.parse("observed = []").body[0],
+        copy.deepcopy(epoch_assignment),
+        epoch_loop,
+        ast.parse("return observed").body[0],
+    ]
+    methods.append(fit_stub)
+    module = ast.Module(body=methods, type_ignores=[])
+    namespace = {"os": os, "torch": torch, "Role": SimpleNamespace(Critic="critic")}
+    checkpoint_source = ast.parse((ROOT / "verl/utils/checkpoint/checkpoint_manager.py").read_text())
+    checkpoint_functions = [
+        node
+        for node in checkpoint_source.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name in {"find_latest_ckpt_path", "get_checkpoint_tracker_filename"}
+    ]
+    exec(compile(ast.Module(body=checkpoint_functions, type_ignores=[]), "checkpoint_manager.py", "exec"), namespace)
+    exec(compile(ast.fix_missing_locations(module), str(path), "exec"), namespace)
+    return type("CpuTrainer", (), {node.name: namespace[node.name] for node in methods})
+
+
+class _Actor:
+    def __init__(self):
+        self.loads = []
+
+    def load_checkpoint(self, path, del_local_after_load):
+        assert Path(path).is_dir()
+        self.loads.append((path, del_local_after_load))
+
+
+def _make_loader(*, workers=0, drop_last=True, size=11, persistent=False, snapshot=1):
+    dataset = list(range(size))
+    sampler = RandomSampler(dataset, generator=torch.Generator().manual_seed(42))
+    return StatefulDataLoader(
+        dataset,
+        sampler=sampler,
+        batch_size=3,
+        drop_last=drop_last,
+        num_workers=workers,
+        persistent_workers=persistent,
+        snapshot_every_n_steps=snapshot,
+    )
+
+
+def _prepare_resume(tmp_path, state, loader, steps, total_epochs=4, path=MAIN_TRAINER):
+    checkpoint = tmp_path / f"global_step_{steps}"
+    (checkpoint / "actor").mkdir(parents=True)
+    if state is not None:
+        torch.save(state, checkpoint / "data.pt")
+    (tmp_path / "latest_checkpointed_iteration.txt").write_text(str(steps))
+    trainer = _load_cpu_trainer(path)()
+    trainer.config = SimpleNamespace(
+        trainer=SimpleNamespace(
+            resume_mode="resume_path",
+            default_hdfs_dir=None,
+            default_local_dir=str(tmp_path),
+            resume_from_path=str(checkpoint),
+            del_local_ckpt_after_load=False,
+            total_epochs=total_epochs,
+        )
+    )
+    trainer.global_steps = 0
+    trainer.train_dataloader = loader
+    trainer.actor_rollout_wg = _Actor()
+    trainer.use_critic = False
+    return trainer
+
+
+def _resume(tmp_path, state, loader, steps, total_epochs=4, path=MAIN_TRAINER):
+    trainer = _prepare_resume(tmp_path, state, loader, steps, total_epochs, path)
+    trainer._load_checkpoint()
+    assert trainer.global_steps == steps
+    assert trainer.actor_rollout_wg.loads == [(str(tmp_path / f"global_step_{steps}" / "actor"), False)]
+    return trainer
+
+
+@pytest.mark.parametrize("path", [MAIN_TRAINER, SEPARATE_TRAINER], ids=["ppo", "separate"])
+def test_boundary_resume_preserves_future_sample_order(tmp_path, path):
+    loader = _make_loader()
+    list(loader)  # Checkpoint in the second data epoch, not the initial shuffle.
+    iterator = iter(loader)
+    for _ in range(len(loader)):
+        next(iterator)
+    state = copy.deepcopy(loader.state_dict())
+    assert state["_iterator_finished"] is False
+    assert list(iterator) == []
+    expected = [(epoch, batch.tolist()) for epoch in range(2, 4) for batch in loader]
+    trainer = _resume(tmp_path, state, _make_loader(), steps=2 * len(loader), path=path)
+    assert trainer.collect() == expected
+
+
+@pytest.mark.parametrize(
+    "worker_config",
+    [
+        {"workers": 0},
+        {"workers": 2},
+        {"workers": 2, "persistent": True},
+        {"workers": 2, "snapshot": 5},
+        {"workers": 2, "persistent": True, "snapshot": 5},
+    ],
+    ids=["single", "multi", "persistent", "stale-snapshot", "persistent-stale-snapshot"],
+)
+@pytest.mark.parametrize("drop_last", [False, True])
+@pytest.mark.parametrize("size", [3, 11, 12])
+@pytest.mark.parametrize("saved_epoch", [0, 2])
+@pytest.mark.parametrize("position", ["initial", "mid", "last", "finished"])
+def test_resume_matrix(tmp_path, worker_config, drop_last, size, saved_epoch, position):
+    kwargs = dict(worker_config, drop_last=drop_last, size=size)
+    loader = _make_loader(**kwargs)
+    for _ in range(saved_epoch):
+        list(loader)
+    iterator = iter(loader)
+    count = {"initial": 0, "mid": max(1, len(loader) // 2), "last": len(loader), "finished": len(loader)}[position]
+    for _ in range(count):
+        next(iterator)
+    if position == "finished":
+        assert list(iterator) == []
+    state = copy.deepcopy(loader.state_dict())
+    assert state["_iterator_finished"] is (position == "finished")
+    expected = [(saved_epoch, batch.tolist()) for batch in iterator]
+    expected.extend((epoch, batch.tolist()) for epoch in range(saved_epoch + 1, saved_epoch + 3) for batch in loader)
+    restored = _make_loader(**kwargs)
+    rng_before_load = restored.sampler.generator.get_state().clone()
+    trainer = _resume(tmp_path, state, restored, steps=saved_epoch * len(loader) + count, total_epochs=saved_epoch + 3)
+    # Restoration must stay lazy: no eager iter(), next(), or permutation advance.
+    assert torch.equal(restored.sampler.generator.get_state(), rng_before_load)
+    assert trainer._dataloader_resume_iterator_finished is (position == "finished")
+    actual = trainer.collect()
+    assert actual == expected
+    assert torch.equal(restored.sampler.generator.get_state(), loader.sampler.generator.get_state())
+
