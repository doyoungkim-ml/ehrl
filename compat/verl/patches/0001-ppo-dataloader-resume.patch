+@pytest.mark.parametrize("path", [MAIN_TRAINER, SEPARATE_TRAINER], ids=["ppo", "separate"])
+def test_missing_data_state_keeps_existing_fresh_epoch_behavior(tmp_path, path):
+    loader = _make_loader()
+    trainer = _resume(tmp_path, None, loader, steps=2 * len(loader), total_epochs=3, path=path)
+    assert trainer._dataloader_resume_iterator_finished is None
+    assert trainer.collect() == [(2, batch.tolist()) for batch in _make_loader()]
+
