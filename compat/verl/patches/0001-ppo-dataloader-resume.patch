+@pytest.mark.parametrize("workers", [0, 2])
+def test_modulo_boundary_does_not_discard_mid_epoch_state(tmp_path, workers):
+    loader = _make_loader(workers=workers)
+    for _ in range(2):
+        list(loader)
+    iterator = iter(loader)
+    next(iterator)
+    state = copy.deepcopy(loader.state_dict())
+    expected = [batch.tolist() for batch in iterator]
+    # An optimizer-step modulo is not a data boundary when batches were rejected.
+    trainer = _resume(tmp_path, state, _make_loader(workers=workers), steps=len(loader))
+    assert [batch.tolist() for batch in trainer.train_dataloader] == expected
