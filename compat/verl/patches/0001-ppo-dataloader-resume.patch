+class _StatefulDataset:
+    def __init__(self):
+        self.visits = 0
+
+    def __len__(self):
+        return 11
+
+    def __getitem__(self, index):
+        self.visits += 1
+        return index
+
+    def state_dict(self):
+        return {"visits": self.visits}
+
+    def load_state_dict(self, state):
+        self.visits = state["visits"]
+
+
+def test_boundary_resume_preserves_dataset_state_without_eager_reads(tmp_path):
+    def make():
+        dataset = _StatefulDataset()
+        sampler = RandomSampler(dataset, generator=torch.Generator().manual_seed(42))
+        return StatefulDataLoader(dataset, sampler=sampler, batch_size=3, drop_last=True, num_workers=0)
+
+    loader = make()
+    iterator = iter(loader)
+    for _ in range(len(loader)):
+        next(iterator)
+    state = copy.deepcopy(loader.state_dict())
+    expected_visits = loader.dataset.visits
+    trainer = _resume(tmp_path, state, make(), steps=len(loader), total_epochs=1)
+    assert trainer.train_dataloader.dataset.visits == 0  # load is lazy, no data read
+    assert trainer.collect() == []  # only the exhausted current epoch remains
+    assert trainer.train_dataloader.dataset.visits == expected_visits
+
+
+@pytest.mark.parametrize("workers", [0, 2])
+@pytest.mark.parametrize("state", [{}, [], [1], 1], ids=["empty-dict", "empty-list", "list", "integer"])
+def test_invalid_data_state_rejected_before_loader_mutation(tmp_path, workers, state):
+    loader = _make_loader(workers=workers)
+    iterator = iter(loader)
+    next(iterator)
+    pending_state = loader.next_iter_state
+    rng_before = loader.sampler.generator.get_state().clone()
+    trainer = _prepare_resume(tmp_path, state, loader, steps=1)
+    trainer._dataloader_resume_iterator_finished = False
+    trainer._dataloader_resume_num_yielded = 1
+    with pytest.raises(ValueError, match="Invalid dataloader checkpoint"):
+        trainer._load_checkpoint()
+    assert trainer._dataloader_resume_iterator_finished is None
+    assert trainer._dataloader_resume_num_yielded is None
+    assert loader._iterator is iterator
+    assert loader.next_iter_state is pending_state
+    assert torch.equal(loader.sampler.generator.get_state(), rng_before)
+
